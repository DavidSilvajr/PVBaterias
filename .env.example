# Copia este archivo a ".env" para pruebas locales (o configura estas
# mismas variables directamente en el panel de tu plataforma de
# despliegue — en Railway, DATABASE_URL se genera sola al agregar un
# servicio de PostgreSQL, no la escribas a mano ahí).

# Cadena de conexión a PostgreSQL. Railway la crea automáticamente
# cuando agregas el plugin de PostgreSQL a tu proyecto.
DATABASE_URL=postgresql://usuario:password@host:5432/nombre_basedatos

# Llave secreta de las sesiones de Flask. Genera una propia con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# NUNCA reutilices el valor de ejemplo de abajo en producción.
SECRET_KEY=cambia-esto-por-una-llave-generada-aleatoriamente

# Opcional. Déjalo apagado (0) en producción.
FLASK_DEBUG=0
